/**
 * @file version.h
 * @brief Version of the HSIM library (generated by CMake from HSIM/version.h.in).
 */
#pragma once

#define HSIM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define HSIM_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define HSIM_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define HSIM_VERSION_STRING "@PROJECT_VERSION@"

namespace hsim {

/// Library version, e.g. "2.0.0".
inline constexpr const char* versionString() { return HSIM_VERSION_STRING; }

} // namespace hsim
